# Корневой шаблон переменных окружения для Docker Compose
GIGACHAT_CREDENTIALS=вставьте_новый_ключ_только_в_локальный_.env_или_в_Render
GIGACHAT_MODEL=GigaChat-2
# GIGACHAT_API_PERS — физлицо; GIGACHAT_API_B2B / GIGACHAT_API_CORP — для юрлиц
GIGACHAT_SCOPE=GIGACHAT_API_PERS
# Публичный адрес сайта — нужен для полных ссылок в напоминаниях
PUBLIC_URL=https://masterboss.onrender.com

VAPID_PUBLIC_KEY=BDwLS9UhWmV794dMkB0ZJQ5_-tsz3eNLuCrNM4UHMh7XxDVq3v-2_8OxNYKcqa-MOqESfJGsK6A_r_PAp22p6q4
VAPID_PRIVATE_KEY=vapid_private.pem
VAPID_EMAIL=mailto:masterboss@example.com

# Секрет подписи токенов входа (любая длинная случайная строка):
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=сгенерируйте_и_вставьте_только_в_.env_или_Render
# PIN мастера anna, который создаётся в пустой базе. Пусто — случайный PIN, он печатается в лог при старте
INITIAL_MASTER_PIN=

PORT=8000
CORS_ORIGINS=*
